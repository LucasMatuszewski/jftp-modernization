# Keep generated evidence hashes valid across platform checkouts.
*.md -text
*.json -text
*.xml -text
README.md text eol=lf
.gitattributes text eol=lf

# Preserve generated source excerpts/packs, including original blank lines.
*.md whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.rust.md whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
*.python.md whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
*.raw.md whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
*.xml whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

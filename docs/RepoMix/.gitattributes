# Preserve generated bytes and their recorded hashes across Windows/Unix checkout.
*.xml -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py text eol=lf
README.md text eol=lf
.gitattributes text eol=lf
